<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── CRITICAL: Pass Authorization header to PHP (Apache strips it by default) ──
    # Without this, Bearer tokens are stripped before reaching Laravel,
    # causing all authenticated API calls to return 401 Unauthenticated.
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # ── Force favicon.ico through Laravel (dynamic favicon from dashboard) ────
    # Must come BEFORE the !-f (file exists) check so the static file is bypassed
    RewriteRule ^favicon.ico$ index.php [L]

    # ── Serve existing static files directly (assets, images, etc.) ──────────
    RewriteCond %{REQUEST_URI} !^/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# ── Performance: gzip/deflate text content ───────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ── Performance: browser cache lifetimes for static assets ───────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"
    ExpiresByType application/font-woff   "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch ".(css|js|jpg|jpeg|png|webp|svg|gif|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

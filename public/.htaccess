<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── SEO: Force HTTPS + non-www in a single hop (no redirect chain) ─────────
    # Rule 1: http://www.horizonooh.com/* → https://horizonooh.com/* (1 hop)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^www\.horizonooh\.com [NC]
    RewriteRule ^ https://horizonooh.com%{REQUEST_URI} [R=301,L]

    # Rule 2: https://www.horizonooh.com/* → https://horizonooh.com/* (1 hop)
    RewriteCond %{HTTPS} on
    RewriteCond %{HTTP_HOST} ^www\.horizonooh\.com [NC]
    RewriteRule ^ https://horizonooh.com%{REQUEST_URI} [R=301,L]

    # Rule 3: http://horizonooh.com/* → https://horizonooh.com/* (1 hop)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^horizonooh\.com [NC]
    RewriteRule ^ https://horizonooh.com%{REQUEST_URI} [R=301,L]

    # ── CRITICAL: Pass Authorization header to PHP (Apache strips it by default) ──
    # Without this, Bearer tokens are stripped before reaching Laravel,
    # causing all authenticated API calls to return 401 Unauthenticated.
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # ── Force favicon.ico through Laravel (dynamic favicon from dashboard) ────
    # Must come BEFORE the !-f (file exists) check so the static file is bypassed
    RewriteRule ^favicon.ico$ index.php [L]

# Precompressed static representations. Preserve original files for identity clients.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b [NC]
    RewriteCond %{HTTP:Accept-Encoding} !\bbr\s*;\s*q=0(?:\.0*)?(?:\s*,|\s*$) [NC]
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.+\.(?:html|css|js|svg))$ $1.br [L]

    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b [NC]
    RewriteCond %{HTTP:Accept-Encoding} !\bgzip\s*;\s*q=0(?:\.0*)?(?:\s*,|\s*$) [NC]
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.+\.(?:html|css|js|svg))$ $1.gz [L]
</IfModule>
<IfModule mod_mime.c>
    AddEncoding br .br
    AddEncoding gzip .gz
    <FilesMatch "\.js\.(br|gz)$">
        ForceType application/javascript
    </FilesMatch>
    <FilesMatch "\.css\.(br|gz)$">
        ForceType text/css
    </FilesMatch>
    <FilesMatch "\.html\.(br|gz)$">
        ForceType text/html
    </FilesMatch>
    <FilesMatch "\.svg\.(br|gz)$">
        ForceType image/svg+xml
    </FilesMatch>
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.(br|gz)$" no-gzip=1 no-brotli=1
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js|svg)(\.(br|gz))?$">
        Header merge Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.(css|js|svg)\.(br|gz)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html\.(br|gz)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

    # Serve generated public pages directly; private routes have no SSG file.
    RewriteCond %{DOCUMENT_ROOT}/ssg/$1/index.html -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/ssg/$1/index.html -f
    RewriteRule ^([A-Za-z0-9/_-]*)/?$ ssg/$1/index.html [L]

    # ── Serve existing static files directly (assets, images, etc.) ──────────
    RewriteCond %{REQUEST_URI} !^/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# ── Performance: gzip/deflate text content ───────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ── Performance: browser cache lifetimes for static assets ───────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"
    ExpiresByType application/font-woff   "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch ".(css|js|jpg|jpeg|png|webp|svg|gif|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
